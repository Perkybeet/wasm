{% import "_escape.j2" as esc %}
# Systemd service for Docker Compose: {{ esc.line(name) }}
# Generated by WASM

[Unit]
Description={{ esc.line(description) }}
Documentation=https://github.com/Perkybeet/wasm
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory={{ esc.line(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if compose_file %}
Environment="COMPOSE_FILE={{ esc.env_value(compose_file) }}"
{% endif %}

# Commands
ExecStartPre=/usr/bin/docker compose pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --remove-orphans --build

# Timeouts
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}

[Install]
WantedBy=multi-user.target
