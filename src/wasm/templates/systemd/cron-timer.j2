{% import "_escape.j2" as esc %}
# WASM cron timer for {{ esc.line(name) }}
# Generated by WASM

[Unit]
Description=WASM cron timer for {{ esc.line(name) }}

[Timer]
OnCalendar={{ esc.line(schedule) }}
{# Persistent, like backup timers: a machine that was off at the scheduled
   moment runs the job at boot instead of silently skipping it, which is the
   anacron behaviour an operator expects from "cron". No randomized delay:
   a user schedule fires when it says it fires. #}
Persistent=true

[Install]
WantedBy=timers.target
