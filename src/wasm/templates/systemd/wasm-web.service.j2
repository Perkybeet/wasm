{% import "_escape.j2" as esc %}
# The WASM console, kept running across reboots.
# Generated by WASM. Written by 'wasm web enable', removed by 'wasm web disable':
# change the options with 'wasm web enable', not here, or the next run undoes it.
# No credential is written here: the access token lives hashed under /etc/wasm.

[Unit]
Description=WASM console
Documentation=https://github.com/Perkybeet/wasm/blob/main/docs/console.md
# A console bound to one address needs that address configured before it binds.
Wants=network-online.target
After=network-online.target
# Restarted on failure, but a hopeless start (a certificate that went missing, a
# port something else took) ends in `failed` after five tries in five minutes
# instead of looping. 'wasm web enable' clears the counter.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Root, as the console always runs: it drives systemd, nginx, certbot and the
# database servers. Spelled out so systemd also sets HOME, USER and LOGNAME,
# which git and npm read during a deploy exactly as under a root shell.
User=root
Group=root
WorkingDirectory=/
# The foreground start, never -d: systemd supervises the process it started.
# --under-systemd serves the token 'wasm web enable' printed and issues none,
# because standard output here is the journal.
ExecStart={{ esc.line(exec_start) }}
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# Hardening that leaves every root operation the console performs intact.
# Deliberately absent: ProtectSystem (the console installs packages into /usr
# and writes nginx, systemd and certificate files under /etc), ProtectHome (an
# application or its source may live under /home), PrivateTmp (a job can hand
# a file to another unit or to dockerd by path), PrivateDevices, the kernel
# tunables and modules protections (package scripts it runs call sysctl and
# modprobe) and MemoryDenyWriteExecute (Node and Python builds need a JIT).
#
# The console is already root; this only keeps a process it starts, such as
# a build running as the application's account, from gaining privileges
# through a setuid binary. WASM switches accounts with runuser, which is root
# giving privileges up, not gaining them.
NoNewPrivileges=true
# Nothing WASM runs reads the kernel ring buffer: the OOM check reads the
# journal (journalctl -k), which this does not touch.
ProtectKernelLogs=true
# Nothing WASM runs changes its execution domain or asks for realtime
# scheduling; both are only ever an exploit's or a runaway process's.
LockPersonality=true
RestrictRealtime=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wasm-web

[Install]
WantedBy=multi-user.target
