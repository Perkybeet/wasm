{% import "_escape.j2" as esc %}
# Systemd service for {{ esc.line(name) }}
# Generated by WASM

[Unit]
Description={{ esc.line(description) }}
Documentation=https://github.com/Perkybeet/wasm
After=network.target

[Service]
Type=simple
User={{ esc.line(user) }}
Group={{ esc.line(group | default(user)) }}
WorkingDirectory={{ esc.line(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}

# Command
ExecStart={{ esc.line(command) }}

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
