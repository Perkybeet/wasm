#!/bin/bash
set -e

case "$1" in
    configure)
        # Interactive mode's prompts come from questionary (Recommends) or,
        # when that is not packaged for the distribution, are explained as
        # missing. WASM never pip-installs into the system Python from a
        # maintainer script: that bypasses dpkg entirely and, on modern
        # Debian and Ubuntu, is refused by PEP 668 unless overridden, which is
        # what --break-system-packages was silently forcing on every upgrade.

        # wasm group: kept for /var/log/wasm below, which predates this file
        # and is unrelated to config.yaml. It must not be used to grant
        # group read access to config.yaml, which holds credentials.
        if ! getent group wasm > /dev/null 2>&1; then
            groupadd --system wasm
        fi

        # Set proper permissions for directories
        if [ -d /var/www/apps ]; then
            chown -R www-data:www-data /var/www/apps
            chmod 755 /var/www/apps
        fi

        if [ -d /var/log/wasm ]; then
            chown -R www-data:wasm /var/log/wasm
            chmod 775 /var/log/wasm
        fi

        # /etc/wasm holds config.yaml's credentials and, when the panel is
        # used, its signing key and token hash (wasm.web.auth). Both must
        # stay owner-only on every install and upgrade: tighten unconditionally
        # rather than only when loose, so this can never widen either one.
        if [ -d /etc/wasm ]; then
            chown root:root /etc/wasm
            chmod 0700 /etc/wasm
        fi
        if [ -f /etc/wasm/config.yaml ]; then
            chown root:root /etc/wasm/config.yaml
            chmod 0600 /etc/wasm/config.yaml
        fi

        # Upgrade config file with new defaults (preserves user values)
        if [ -f /etc/wasm/config.yaml ]; then
            echo "Upgrading configuration with new defaults..."
            wasm config upgrade --quiet 2>/dev/null || true
        fi

        # Update wasm-monitor service if it exists and is enabled
        if systemctl is-enabled wasm-monitor.service >/dev/null 2>&1; then
            echo "Updating wasm-monitor service..."
            # Reinstall service file with new version
            wasm monitor install >/dev/null 2>&1 || true
            # Reload systemd and restart service
            systemctl daemon-reload
            systemctl restart wasm-monitor.service || true
            echo "wasm-monitor service updated and restarted"
            echo ""
            echo "NOTE: the monitor no longer terminates processes or deletes files."
            echo "It decided what was malicious by matching substrings against a"
            echo "process command line, and acted on that as root. It now reports"
            echo "resource use, service health and notable processes, and acts on"
            echo "nothing. The auto_terminate and use_ai settings are ignored."
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
