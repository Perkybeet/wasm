#!/usr/bin/make -f

export PYBUILD_NAME=wasm
export DH_VERBOSE=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Config directory: owner-only, since config.yaml holds credentials and,
	# when the panel is used, wasm.web.auth's signing key and token hash live
	# here too.
	install -d -m 0700 debian/wasm/etc/wasm
	# Default config, owner-only: matches wasm.core.fs.SECRET_MODE.
	install -m 0600 debian/wasm.default.yaml debian/wasm/etc/wasm/config.yaml
	# Create apps directory
	install -d debian/wasm/var/www/apps
	# Create log directory
	install -d debian/wasm/var/log/wasm
	# Shell completion. Committed, not generated here: Click's scripts contain
	# no command names, so they cannot drift, and running Python during the
	# build would make every runtime import a build dependency. That is what
	# failed all twenty-two OBS targets.
	install -Dm644 src/wasm/completions/wasm.bash \
		debian/wasm/usr/share/bash-completion/completions/wasm
	install -Dm644 src/wasm/completions/_wasm \
		debian/wasm/usr/share/zsh/vendor-completions/_wasm
	install -Dm644 src/wasm/completions/wasm.fish \
		debian/wasm/usr/share/fish/vendor_completions.d/wasm.fish

override_dh_fixperms:
	dh_fixperms
	# dh_fixperms normalises every directory to 0755 and every file to 0644,
	# undoing the modes set above. Re-tighten just these two paths afterwards
	# so the shipped package still has them, regardless of dh_fixperms
	# defaults on any debhelper version.
	chmod 0700 debian/wasm/etc/wasm
	chmod 0600 debian/wasm/etc/wasm/config.yaml

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_test:
	@echo "Skipping tests during package build"