#!/usr/bin/make -f

export PYBUILD_NAME=wasm
export DH_VERBOSE=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Create config directory
	install -d debian/wasm/etc/wasm
	# Install default config
	install -m 644 debian/wasm.default.yaml debian/wasm/etc/wasm/config.yaml
	# Create apps directory
	install -d debian/wasm/var/www/apps
	# Create log directory
	install -d debian/wasm/var/log/wasm
	# Shell completion, generated from the command tree rather than written by
	# hand. The hand-written scripts were 2,295 lines kept in step with 108
	# subcommands from memory, so they were wrong. Generating them needs no
	# network, which the build environment does not have.
	install -d debian/wasm/usr/share/bash-completion/completions
	install -d debian/wasm/usr/share/zsh/vendor-completions
	install -d debian/wasm/usr/share/fish/vendor_completions.d
	PYTHONPATH=src _WASM_COMPLETE=bash_source python3 -m wasm \
		> debian/wasm/usr/share/bash-completion/completions/wasm
	PYTHONPATH=src _WASM_COMPLETE=zsh_source python3 -m wasm \
		> debian/wasm/usr/share/zsh/vendor-completions/_wasm
	PYTHONPATH=src _WASM_COMPLETE=fish_source python3 -m wasm \
		> debian/wasm/usr/share/fish/vendor_completions.d/wasm.fish

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_test:
	@echo "Skipping tests during package build"