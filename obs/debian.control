Source: wasm
Section: admin
Priority: optional
Maintainer: Yago López Prado <yago.lopez.adeje@gmail.com>
# Generating the shell completions runs the package, so everything it imports
# at import time is needed at build time too, not only at run time. Leaving
# these out is what made every OBS target fail with ModuleNotFoundError while
# the GitHub runner, which happens to ship python3-yaml, built fine.
# Only what builds a wheel. Nothing here runs the package: the shell
# completions are committed rather than generated, which is what removed
# the whole class of failure where every runtime import became a build
# dependency on every distribution and every architecture.
Build-Depends: debhelper-compat (= 13),
               dh-python,
               pybuild-plugin-pyproject,
               python3-all,
               python3-setuptools,
               python3-wheel
Standards-Version: 4.6.0
Homepage: https://github.com/Perkybeet/wasm
Rules-Requires-Root: no

Package: wasm
Architecture: all
Depends: ${python3:Depends},
         ${misc:Depends},
         python3 (>= 3.10),
         python3-pip,
         python3-yaml,
         python3-jinja2,
         python3-click,
         python3-rich,
         nginx | apache2,
         certbot
# python3-inquirer does not exist in Debian or Ubuntu, so the interactive mode
# it gated never worked on those distributions. Prompts use questionary, which
# is packaged from Debian 13 and Ubuntu 24.04 onwards.
#
# questionary is a Recommends rather than a Depends because it is absent from
# Debian 12 and Ubuntu 22.04, where a Depends built a package apt then refused
# to install. apt installs Recommends by default, so nothing changes on the
# releases that have it, and on the two that do not the package installs and
# interactive mode explains what is missing.
Recommends: python3-questionary,
            python3-fastapi,
            python3-starlette,
            python3-pydantic,
            python3-uvicorn,
            python3-psutil
Suggests: git,
          nodejs,
          npm
Description: Web App System Management CLI Tool
 WASM is a robust CLI tool for deploying and managing web applications
 on Linux servers. It handles site configuration (Nginx/Apache), SSL
 certificates (Certbot), systemd services, and automated deployment
 workflows for various application types.
 .
 Features:
  - Deploy Next.js, Node.js, Vite, Python, and static applications
  - Nginx and Apache site management
  - SSL certificate management via Certbot/Let's Encrypt
  - Systemd service management
  - Interactive mode with guided prompts
  - Web dashboard for remote management (optional)
  - REST API with token-based authentication
  - Backup and rollback system
  - AI-powered security monitoring
