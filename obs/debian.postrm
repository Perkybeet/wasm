#!/bin/bash
set -e

case "$1" in
    remove)
        echo "Removing WASM..."
        # Don't remove apps or configuration on remove
        ;;
    
    purge)
        echo "Purging WASM configuration..."
        # Remove configuration
        rm -rf /etc/wasm
        # Remove logs
        rm -rf /var/log/wasm
        # Note: We intentionally don't remove /var/www/apps
        # to prevent accidental data loss
        echo "Note: /var/www/apps was not removed to prevent data loss"

        # 'wasm web enable' and 'wasm monitor install' write these units at
        # runtime; dpkg never shipped them, so it would leave them behind
        # naming a /usr/bin/wasm that is gone. prerm has already stopped and
        # disabled them. Only a regular file carrying WASM's marker is
        # removed: one the operator wrote under the same name is theirs.
        units_removed=
        for unit in wasm-web.service wasm-monitor.service; do
            unit_path="/etc/systemd/system/$unit"
            if [ -f "$unit_path" ] && [ ! -L "$unit_path" ] \
                && grep -q "Generated by WASM" "$unit_path"; then
                rm -f "$unit_path"
                units_removed=1
            fi
        done
        if [ -n "$units_removed" ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
